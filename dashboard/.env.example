# Leave empty to connect to the page's own host (/ws) — correct behind the compose/kind ingress.
# For `npm run dev` on :3000 against the compose stack:
#   NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws   (and set ALLOWED_ORIGINS if you hit the gateway directly)
NEXT_PUBLIC_WS_URL=

# `next dev` only: proxy /v1/* to the running stack (read at build/start time).
#   API_ORIGIN=http://localhost:8080
API_ORIGIN=
# NEXT_PUBLIC_WS_URL for next dev: next rewrites cannot proxy WebSockets
#   NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
