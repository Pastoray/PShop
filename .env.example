# Copy to .env. Everything has a dev default; override for anything shared or long-lived.
POSTGRES_PASSWORD=pshop
RABBITMQ_PASSWORD=pshop
GRAFANA_PASSWORD=admin

# Signing key for invoices; it is written to AWS Secrets Manager (LocalStack) by Terraform.
INVOICE_SIGNING_KEY=dev-only-change-me

# LocalStack: the latest images require a (free-tier) auth token since 2026-03-23.
# The default pinned tag below predates that. To use a newer tag, set both:
LOCALSTACK_TAG=4.12
LOCALSTACK_AUTH_TOKEN=

# Only needed when running `next dev` on :3000 against the compose gateway.
ALLOWED_ORIGINS=

RUST_LOG=info
